PS>function Invoke-BiznoryxSqlFile {
    param(
        [Parameter(Mandatory)][string]$Path
    )

    if (-not (Test-Path $Path)) {
        throw "SQL file does not exist: $Path"
    }

    if ($script:DatabaseMode -eq "url") {

        if (-not (Test-CommandAvailable "psql")) {
            Fail-Safely "psql is required when using a PostgreSQL connection URL."
        }

        & psql `
            $script:DatabaseUrl `
            -X `
            -v ON_ERROR_STOP=1 `
            -f $Path

        if ($LASTEXITCODE -ne 0) {
            throw "Migration execution failed."
        }

        return
    }

    $Sql = Get-Content $Path -Raw

    $Sql | & docker compose exec -T postgres `
        psql `
        -U biznoryx_admin `
        -d biznoryx `
        -X `
        -v ON_ERROR_STOP=1

    if ($LASTEXITCODE -ne 0) {
        throw "Migration execution failed."
    }
}
