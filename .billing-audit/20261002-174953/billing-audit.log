PS>if (-not $SkipVerification) {

    Write-Section "11. APPLICATION REGRESSION CHECK"

    if (-not (Test-CommandAvailable "node")) {
        Fail-Safely "Node.js is not installed or is unavailable in PATH."
    }

    if (-not (Test-CommandAvailable "npm")) {
        Fail-Safely "npm is not installed or is unavailable in PATH."
    }

    $NodeVersionRaw = (& node --version).Trim()
    Write-Host "Node: $NodeVersionRaw"

    $NodeMajor = [int](($NodeVersionRaw -replace '^v', '').Split('.')[0])

    if ($NodeMajor -lt 24) {
        Fail-Safely @"
BIZNORYX currently requires Node.js >= 24.

Installed:
$NodeVersionRaw
"@
    }

    Write-Host ""
    Write-Host "Running BIZNORYX verification pipeline..." -ForegroundColor Cyan

    & npm run verify

    if ($LASTEXITCODE -ne 0) {
        Fail-Safely "npm run verify failed. Review the output before deployment."
    }

    Write-OK "Format, lint, type, migration, security, tests and build checks passed."

    # Billing-specific browser regression tests.
    $BillingBrowserTests = @(
        "tests\browser\billing-history.spec.mjs",
        "tests\browser\billing-history-records.spec.mjs"
    ) | Where-Object {
        Test-Path (Join-Path $RepoRoot $_)
    }

    if ($BillingBrowserTests.Count -gt 0) {

        Write-Host ""
        Write-Host "Running billing-history browser regression tests..." -ForegroundColor Cyan

        & npx playwright test @BillingBrowserTests

        if ($LASTEXITCODE -ne 0) {
            Fail-Safely @"
Billing-history browser regression testing failed.

The database repair was backed up, but do not deploy until this browser
failure has been investigated.
"@
        }

        Write-OK "Billing history browser regression tests passed."
    }
    else {
        Write-Warn "Billing-specific Playwright files were not found; browser regression test skipped."
    }
}

