PS>if (Test-CommandAvailable "git") {

    $InsideRepo = (& git rev-parse --is-inside-work-tree 2>$null).Trim()

    if ($InsideRepo -ne "true") {
        Fail-Safely "The current directory is not a Git working tree."
    }

    $Branch = (& git branch --show-current).Trim()
    $Commit = (& git rev-parse HEAD).Trim()
    $Dirty = (& git status --porcelain)

    Write-Host "Branch : $Branch"
    Write-Host "Commit : $Commit"

    if ($Dirty) {
        Write-Warn "The repository has uncommitted changes."
        Write-Host ""
        & git status --short
        Write-Host ""
        Write-Warn "The script will NOT overwrite or reset those changes."
    }
    else {
        Write-OK "Git working tree is clean."
    }

    if (-not $SkipGitFetch) {
        try {
            Write-Host "Refreshing origin/main metadata..."
            & git fetch origin main --quiet

            if ($LASTEXITCODE -eq 0) {
                $RemoteMain = (& git rev-parse origin/main).Trim()

                Write-Host "origin/main: $RemoteMain"

                if ($Commit -eq $RemoteMain) {
                    Write-OK "Local HEAD matches origin/main."
                }
                else {
                    $IsAncestor = $false

                    & git merge-base --is-ancestor HEAD origin/main 2>$null

                    if ($LASTEXITCODE -eq 0) {
                        $IsAncestor = $true
                    }

                    if ($IsAncestor) {
                        Write-Warn "Your local checkout is behind origin/main."
                        Write-Warn "This script will not automatically merge application code."
                    }
                    else {
                        Write-Warn "Local HEAD and origin/main differ. No automatic Git mutation will occur."
                    }
                }
            }
        }
        catch {
            Write-Warn "Unable to refresh origin/main. Continuing with the checked-out source."
        }
    }
}
