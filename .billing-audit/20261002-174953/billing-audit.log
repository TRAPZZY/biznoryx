PS>function Invoke-BiznoryxSql {
    param(
        [Parameter(Mandatory)][string]$Sql,
        [switch]$TuplesOnly
    )

    if ($script:DatabaseMode -eq "url") {

        if (-not (Test-CommandAvailable "psql")) {
            Fail-Safely "psql is required when using a PostgreSQL connection URL."
        }

        $Args = @(
            $script:DatabaseUrl,
            "-X",
            "-v", "ON_ERROR_STOP=1"
        )

        if ($TuplesOnly) {
            $Args += @("-A", "-t")
        }

        $Args += @("-c", $Sql)

        $Output = & psql @Args 2>&1

        if ($LASTEXITCODE -ne 0) {
            throw ($Output -join [Environment]::NewLine)
        }

        return ($Output -join [Environment]::NewLine).Trim()
    }

    $DockerArgs = @(
        "compose",
        "exec",
        "-T",
        "postgres",
        "psql",
        "-U", "biznoryx_admin",
        "-d", "biznoryx",
        "-X",
        "-v", "ON_ERROR_STOP=1"
    )

    if ($TuplesOnly) {
        $DockerArgs += @("-A", "-t")
    }

    $DockerArgs += @("-c", $Sql)

    $Output = & docker @DockerArgs 2>&1

    if ($LASTEXITCODE -ne 0) {
        throw ($Output -join [Environment]::NewLine)
    }

    return ($Output -join [Environment]::NewLine).Trim()
}
