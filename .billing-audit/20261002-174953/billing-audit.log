PS>function Backup-Query {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$Sql
    )

    $Path = Join-Path $AuditRoot "$Name.jsonl"

    try {
        $Data = Invoke-BiznoryxSql -TuplesOnly -Sql $Sql

        [System.IO.File]::WriteAllText(
            $Path,
            $Data,
            [System.Text.UTF8Encoding]::new($false)
        )

        Write-OK "Backed up $Name"
    }
    catch {
        Write-Warn "Unable to back up $Name : $($_.Exception.Message)"
        throw
    }
}
