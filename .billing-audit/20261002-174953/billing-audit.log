PS>$FinalSnapshot = Invoke-BiznoryxSql -TuplesOnly -Sql @"
select
  json_build_object(
    'subscriptions',
      (select count(*) from organization_billing_subscriptions),

    'active_subscriptions',
      (
        select count(*)
        from organization_billing_subscriptions
        where status = 'active'
      ),

    'completed_checkouts',
      (
        select count(*)
        from billing_checkout_sessions
        where provider = 'paystack'
          and status = 'completed'
      ),

    'payment_history_records',
      (
        select count(*)
        from billing_payments
        where provider = 'paystack'
      ),

    'missing_completed_checkout_payments',
      (
        select count(*)
        from billing_checkout_sessions c
        left join billing_payments p
          on p.provider = c.provider
         and p.reference = c.reference
        where c.provider = 'paystack'
          and c.status = 'completed'
          and c.completed_at is not null
          and p.id is null
      )
  )::text;
"@
