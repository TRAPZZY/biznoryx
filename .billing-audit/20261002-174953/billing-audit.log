PS>else {

    $CompletedCheckoutCount = Invoke-BiznoryxSql -TuplesOnly -Sql @"
select count(*)
from billing_checkout_sessions
where provider = 'paystack'
  and status = 'completed'
  and completed_at is not null;
"@

    $PaymentCount = Invoke-BiznoryxSql -TuplesOnly -Sql @"
select count(*)
from billing_payments
where provider = 'paystack'
  and status = 'success';
"@

    $MissingPaymentCount = Invoke-BiznoryxSql -TuplesOnly -Sql @"
select count(*)
from billing_checkout_sessions c
left join billing_payments p
  on p.provider = c.provider
 and p.reference = c.reference
where c.provider = 'paystack'
  and c.status = 'completed'
  and c.completed_at is not null
  and p.id is null;
"@

    $ConflictingPaymentCount = Invoke-BiznoryxSql -TuplesOnly -Sql @"
select count(*)
from billing_checkout_sessions c
join billing_payments p
  on p.provider = c.provider
 and p.reference = c.reference
where c.provider = 'paystack'
  and c.status = 'completed'
  and (
       p.organization_id <> c.organization_id
    or p.amount_minor <> c.amount_minor
    or upper(p.currency) <> upper(c.currency)
  );
"@

    Write-Host ""
    Write-Host "Completed Paystack checkouts : $CompletedCheckoutCount"
    Write-Host "Recorded Paystack payments  : $PaymentCount"
    Write-Host "Missing history records     : $MissingPaymentCount"
    Write-Host "Conflicting history records : $ConflictingPaymentCount"
    Write-Host ""

    if ([int64]$ConflictingPaymentCount -gt 0) {

        $ConflictFile = Join-Path $AuditRoot "payment-conflicts.txt"

        $ConflictDetails = Invoke-BiznoryxSql -TuplesOnly -Sql @"
select
    'reference=' || c.reference ||
    ' checkout_org=' || c.organization_id ||
    ' payment_org=' || p.organization_id ||
    ' checkout_amount=' || c.amount_minor ||
    ' payment_amount=' || p.amount_minor ||
    ' checkout_currency=' || c.currency ||
    ' payment_currency=' || p.currency
from billing_checkout_sessions c
join billing_payments p
  on p.provider = c.provider
 and p.reference = c.reference
where c.provider = 'paystack'
  and c.status = 'completed'
  and (
       p.organization_id <> c.organization_id
    or p.amount_minor <> c.amount_minor
    or upper(p.currency) <> upper(c.currency)
  )
order by c.completed_at;
"@

        Set-Content `
            -Path $ConflictFile `
            -Value $ConflictDetails `
            -Encoding UTF8

        Fail-Safely @"
A financial-history conflict was detected.

The script intentionally WILL NOT rewrite an existing payment.

Conflict evidence:
$ConflictFile
"@
    }

    if ([int64]$MissingPaymentCount -gt 0) {

        Write-Warn "Your suspicion is confirmed."
        Write-Warn "$MissingPaymentCount completed Paystack checkout(s) are missing from billing history."

        if ($AuditOnly) {
            Write-Warn "AuditOnly is enabled. No records will be inserted."
        }
        else {

            Write-Host ""
            Write-Host "Repairing missing history records..." -ForegroundColor Cyan

            $RepairResult = Invoke-BiznoryxSql -TuplesOnly -Sql @"
with repaired as (
    insert into billing_payments (
        organization_id,
        provider,
        reference,
        status,
        amount_minor,
        currency,
        channel,
        paid_at
    )
    select
        c.organization_id,
        c.provider,
        c.reference,
        'success',
        c.amount_minor,
        upper(c.currency),
        null,
        c.completed_at
    from billing_checkout_sessions c
    left join billing_payments p
      on p.provider = c.provider
     and p.reference = c.reference
    where c.provider = 'paystack'
      and c.status = 'completed'
      and c.completed_at is not null
      and p.id is null
    on conflict (provider, reference) do nothing
    returning reference
)
select reference
from repaired
order by reference;
"@

            if ($RepairResult) {
                Write-Host ""
                Write-Host "Repaired references:" -ForegroundColor Green
                Write-Host $RepairResult
            }

            $RemainingMissing = Invoke-BiznoryxSql -TuplesOnly -Sql @"
select count(*)
from billing_checkout_sessions c
left join billing_payments p
  on p.provider = c.provider
 and p.reference = c.reference
where c.provider = 'paystack'
  and c.status = 'completed'
  and c.completed_at is not null
  and p.id is null;
"@

            if ([int64]$RemainingMissing -ne 0) {
                Fail-Safely "$RemainingMissing payment-history records remain missing after repair."
            }

            Write-OK "Completed checkouts now have corresponding billing-history records."
        }
    }
    else {
        Write-OK "No completed checkout is missing from billing_payments."
    }
}
