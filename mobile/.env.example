# Public values compiled into the native application. Never put server secrets here.
MOBILE_API_ORIGIN=https://biznoryx.com
MOBILE_REVENUECAT_APPLE_KEY=
MOBILE_REVENUECAT_GOOGLE_KEY=
# Set these in the backend/worker secret manager, NOT in the mobile build environment:
# REVENUECAT_SECRET_API_KEY
# REVENUECAT_ENTITLEMENT_ID
# REVENUECAT_APPLE_PRODUCT_IDS (comma-separated monthly product identifiers)
# REVENUECAT_GOOGLE_PRODUCT_IDS (comma-separated subscription:base-plan identifiers)
# REVENUECAT_SANDBOX_ORGANIZATION_IDS (dedicated sandbox/reviewer organizations only)
